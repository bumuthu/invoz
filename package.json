{
  "name": "invoz",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "supabase"
  ],
  "scripts": {
    "dev:portal": "npm run dev -w portal-app",
    "dev:admin": "npm run dev -w admin-app",
    "dev:landing": "npm run dev -w landing-app",
    "dev:ramis": "npm run dev -w @invoz/engine",
    "test:ramis": "npm run test -w @invoz/engine",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @invoz/supabase",
    "migrate:ramis": "npm run migrate -w @invoz/engine",
    "seed": "npm run seed -w @invoz/supabase",
    "onboard:json": "npm run onboard:json -w @invoz/supabase --",
    "onboard": "npm run onboard -w @invoz/supabase --",
    "onboard:sftp": "npm run provision:sftp-user -w @invoz/deployment --",
    "provision": "npm run provision -w @invoz/deployment",
    "provision:ramis": "npm run provision:ramis -w @invoz/deployment",
    "provision:landing": "npm run provision:landing -w @invoz/deployment",
    "sync:invoices": "npm run sync -w @invoz/invoice-uploader --"
  }
}
