AWS_REGION=ap-south-1

# stag or prod. Every AWS name is invoz-{APP_ENV}-{resource}.
APP_ENV=stag

# ISSUED ACM certificate in AWS_REGION. *.api.invoz.lk covers both HTTP APIs.
# stag: stag-ramis.api.invoz.lk, stag-landing.api.invoz.lk
# prod: ramis.api.invoz.lk, landing.api.invoz.lk
API_CERTIFICATE_ARN=

# Organization files: s3://invoz-$APP_ENV-invoices/uploads/{organization uuid}/{legal entity uuid}/inbound/*.csv

# Lambda settings live with each function:
#   packages/invoice-engine/.env
#   tools/ramis-engine/.env
#   packages/landing-service/.env
