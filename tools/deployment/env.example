AWS_REGION=ap-south-1

# One bucket per organization: {organization uuid}-invoice-bucket
# ORGANIZATION_ID=<uuid> npm run provision:s3 -w @invoz/deployment

# Portal database. Used by invoice-engine and landing-service.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# RAMIS engine database. Separate from the portal Supabase database.
RAMIS_DATABASE_URL=postgres://user:password@host:5432/ramis_engine
RAMIS_MOCK_CLIENT_SECRET=ramis-mock-secret

# Paste the URL printed by npm run provision:ramis, then provision the invoice Lambda again.
RAMIS_API_URL=
