AWS_REGION=ap-south-1

# stag or prod. Every AWS name is invoz-{APP_ENV}-{resource}.
APP_ENV=stag

# Organization files: s3://invoz-$APP_ENV-invoices/uploads/{organization uuid}/{legal entity uuid}/inbound/*.csv

# Portal database. Used by invoice-engine and landing-service.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Postgres URL for the RAMIS mock. The engine uses schema ramis_engine only.
RAMIS_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:5432/ramis_engine
RAMIS_MOCK_CLIENT_SECRET=ramis-mock-secret

# Paste the URL printed by npm run provision:ramis, then provision the invoice Lambda again.
RAMIS_API_URL=

# Demo email. Leave false unless SMTP_HOST, SMTP_USER, and SMTP_PASSWORD are set.
LANDING_EMAIL_ENABLED=false
