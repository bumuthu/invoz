# Published to invoz-{env}-ramis-engine. provision:ramis reads this file only.

# Postgres URL. The path selects schema ramis_engine inside database postgres.
# Session pooler, port 5432. The direct db host is IPv6-only, so Lambda cannot open it.
RAMIS_DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/ramis_engine

# Client secret checked by the RAMIS mock.
RAMIS_MOCK_CLIENT_SECRET=ramis-mock-secret
