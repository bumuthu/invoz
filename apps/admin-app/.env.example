# Browser sign-in. The anon key is public and must not be able to read tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. The service role creates customer owners and signs the admin session cookie.
# Admin passwords are not stored here. Create an admin with npm run admin:create.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# SFTP approval reads the Transfer server and writes the upload prefix. stag or prod.
APP_ENV=stag
AWS_REGION=ap-south-1
