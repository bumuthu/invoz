# Browser sign-in. The anon key is public and must not be able to read tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Do not prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Transaction pooler, port 6543. Amplify cannot open the IPv6-only direct host.
# Session mode on port 5432 allows 15 clients for the whole project, and Prisma opens one per core.
# Username is postgres.{project-ref}. pgbouncer=true lets Prisma run on the transaction pooler.
DATABASE_URL=

# true in production and staging: the default host only signs in, then opens the organization host.
# false for local testing: localhost shows that same login form, then stays on localhost.
PORTAL_REQUIRE_ORG_HOST=false

# Server only. FIFO queue the invoice-engine Lambda consumes.
# A corrected document is sent here. The Lambda posts it to RAMIS and writes the status.
INVOICE_QUEUE_URL=
