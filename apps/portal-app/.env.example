# Browser sign-in. The anon key is public and must not be able to read tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Do not prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by Prisma. Port 5432, not the transaction pooler.
DATABASE_URL=

# Production root is invoiz.lk, so the default portal is app.invoz.lk.
# Staging root is stag.invoz.lk, so the default portal is app.stag.invoz.lk.
# An organization portal is {slug}.{root}.
NEXT_PUBLIC_ROOT_DOMAIN=invoz.lk

# true in production and staging: the default host only signs in, then opens {slug}.{root}.
# false for local testing: localhost shows that same login form, then stays on the root URL.
PORTAL_REQUIRE_ORG_HOST=false
