# Browser sign-in. The anon key is public and must not be able to read tables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Do not prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection used by Prisma. Port 5432, not the transaction pooler.
DATABASE_URL=

# true in production and staging: the default host only signs in, then opens the organization host.
# false for local testing: localhost shows that same login form, then stays on localhost.
PORTAL_REQUIRE_ORG_HOST=false
