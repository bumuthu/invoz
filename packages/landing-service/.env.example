# Published to invoz-{env}-landing-service. provision:landing reads this file only.

# Session pooler, port 5432. The direct db host is IPv6-only, so Lambda cannot open it.
# Use username postgres.{project-ref} and the pooler host. Do not use port 6543.
DATABASE_URL=

# Set to true to email demo requests. SMTP settings below are used only then.
LANDING_EMAIL_ENABLED=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEMO_FROM_EMAIL=

# Comma-separated browser origins allowed to call this API.
# When unset, invoz.lk, local landing, and Amplify preview hosts are allowed.
LANDING_ALLOWED_ORIGINS=
