# Published to invoz-{env}-erp-poll-s4hana. provision:erp-poll-lambda reads this file.
# The script also sets APP_ENV from the shell. API username and password are on the connection.

# Session pooler, port 5432. The direct db host is IPv6-only, so Lambda cannot open it.
DATABASE_URL=

# Shared invoice bucket, invoz-{env}-invoices. Polled CSVs land under uploads/.
INVOICE_BUCKET=
