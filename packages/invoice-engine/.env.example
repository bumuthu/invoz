# Published to invoz-{env}-invoice-engine. provision:lambda reads this file only.

# Session pooler, port 5432, used by Prisma for the clearance transaction.
# The direct db host is IPv6-only, so Lambda cannot open it. Do not use port 6543.
DATABASE_URL=

# RAMIS HTTP API base URL, with no path. Staging is the invoz-stag-ramis-engine endpoint.
RAMIS_API_URL=

# Client secret sent to RAMIS_API_URL.
# When that URL is the mock, use the same value as RAMIS_MOCK_CLIENT_SECRET in tools/ramis-engine/.env.
RAMIS_CLIENT_SECRET=
